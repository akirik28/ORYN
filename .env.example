# Copy to .env.local and fill in. See API_SETUP.md for where to get each value, what it's
# used for, and how the app behaves when it's left blank (every integration below is
# optional at the process level — the app boots and serves the core product regardless).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SECRET_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# The model a *degraded* call falls back to once a student passes MONTHLY_BUDGET_TARGET_USD
# ($0.50) in lib/ai/limits/budget.ts. Deliberately separate from ANTHROPIC_MODEL, which stays
# the ceiling model every non-degraded call uses — so the degrade target can be retuned without
# touching the main model's configuration. Defaults to claude-haiku-4-5 when blank.
#
# Worth knowing before changing it: the tier proposal's free-tier costing assumes Haiku here,
# and as of 2026-09-02 every real call in the database is Sonnet — that configuration has never
# actually run against a student, so the measured per-call costs are ceiling prices.
ANTHROPIC_DEGRADE_MODEL=

TAVILY_API_KEY=

COLLEGE_SCORECARD_API_KEY=

OPENALEX_CONTACT_EMAIL=

CRON_SECRET=

# Salts the anonymous visitor-hash written by lib/analytics/page-views.ts (landing-page
# view counting, migration 0107 — proposed, not yet applied). Generate with
# `openssl rand -hex 32`. Without it set, recording is skipped entirely — it does not fall
# back to hashing with a predictable secret, and the admin traffic screen keeps showing its
# honest "not measured" state either way (the table not existing yet has the same effect).
PAGE_VIEW_HASH_SECRET=

# Admin "remaining credit" card (app/(app)/admin) — Anthropic's balance isn't readable from the
# API, so this is a manually-entered starting figure, edited by hand each time the account is
# topped up. Both must be set for the card to render; the card is hidden (not shown as $0) when
# either is missing.
ADMIN_STARTING_CREDIT_USD=
ADMIN_STARTING_CREDIT_ENTERED_AT=

# The admin finance dashboard's USD/TRY rate and Ultra price used to live here as env vars
# (ADMIN_USD_TRY_RATE/_ENTERED_AT) -- superseded 2026-09-02 by admin_finance_settings
# (migration 0094), editable from the admin panel itself rather than needing a redeploy. No
# env var reads them anymore; set both from the Finance section in-app. See
# docs/maliyet-ve-fiyatlandirma-2026-09-02.md for why the rate specifically is never guessed
# when unset.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Error tracking. Leave blank locally: with no DSN, lib/monitoring falls back to a console
# reporter, which is what you want in dev anyway. Set it in production — docs/deployment.md
# step 7. SENTRY_ENVIRONMENT and SENTRY_RELEASE are optional overrides; on Vercel they are
# derived from VERCEL_ENV and VERCEL_GIT_COMMIT_SHA automatically.
SENTRY_DSN=

# Two existing QA accounts (oryn.qa.a@example.com / oryn.qa.b@example.com, both onboarded),
# read by scripts/rls-verify-surface1-u-id.ts to check RLS from two real sessions rather than
# from the service role. Leave blank unless you're running that script.
#
# Filling these in also unblocks something broader: several audits have had to stop short of
# verifying an authenticated page live, because reaching a post-auth surface needs a real
# session and creating a throwaway account is not permitted. These accounts already exist —
# only their passwords are missing locally.
QA_ACCOUNT_A_EMAIL=
QA_ACCOUNT_A_PASSWORD=
QA_ACCOUNT_B_EMAIL=
QA_ACCOUNT_B_PASSWORD=
