ANTHROPIC_MODEL=

TAVILY_API_KEY=

COLLEGE_SCORECARD_API_KEY=

OPENALEX_CONTACT_EMAIL=

CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
